# ====================================================================
# provi AI · Variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# ====================================================================

# Supabase (https://supabase.com/dashboard/project/_/settings/api )
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cC...

# Anthropic Claude (https://console.anthropic.com/settings/keys )
# Se usa SOLO en server-side para el matching de Provi Bot.
# Sin esto, /api/match cae a matching por reglas.
ANTHROPIC_API_KEY=sk-ant-...

# Twilio Sandbox WhatsApp (https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn )
# Estos son los datos del sandbox de Twilio. Los usás solo para mostrar
# el número y el código al usuario en la pantalla de conexión.
NEXT_PUBLIC_TWILIO_WHATSAPP_NUMBER=+1 415 523 8886
NEXT_PUBLIC_TWILIO_SANDBOX_CODE=join <tu-código-aleatorio>
